{
  "name": "@proyectojacky/jacky",
  "version": "0.1.1",
  "description": "Jacky web pet plugin: framework-agnostic sprite engine + React wrapper with .jacky skin support (Workshop, URL, folder, drag & drop).",
  "keywords": [
    "jacky",
    "desktop-pet",
    "web-pet",
    "sprite",
    "canvas",
    "shimeji",
    "react"
  ],
  "license": "MIT",
  "author": "Proyecto Jacky",
  "homepage": "https://jacky.club/plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/proyectojacky/jacky-web-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/proyectojacky/jacky-web-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:manifest": "node scripts/generate-skin-manifest.mjs",
    "smoke": "node scripts/smoke-browser.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "vitest": "^2.0.5"
  }
}
